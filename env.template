# Copiar a .env.local y rellenar. Solo servidor: nunca usar prefijo NEXT_PUBLIC_.
RESEND_API_KEY=
# Destinatario del equipo. Con onboarding@resend.dev, debe ser el correo dueño de la cuenta Resend.
CONTACT_TO_EMAIL=
# onboarding@resend.dev mientras no haya dominio verificado en Resend.
CONTACT_FROM_EMAIL=

# Supabase: URL del proyecto y clave publishable. Son públicas (NEXT_PUBLIC_), protegidas por RLS.
# Nunca poner aquí la service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
