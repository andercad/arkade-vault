# Copiar a .env.local y rellenar. Solo servidor: nunca usar prefijo NEXT_PUBLIC_.
RESEND_API_KEY=
# Destinatario del equipo. Con onboarding@resend.dev, debe ser el correo dueño de la cuenta Resend.
CONTACT_TO_EMAIL=
# onboarding@resend.dev mientras no haya dominio verificado en Resend.
CONTACT_FROM_EMAIL=

# Supabase: URL del proyecto y clave publishable. Son públicas (NEXT_PUBLIC_), protegidas por RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SPEC 16: secret key de Supabase (sb_secret_...). Solo servidor: nunca prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# SPEC 20: origen publico (sin barra final), p. ej. https://arcade-vault.vercel.app. Obligatoria en produccion; en dev, http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
